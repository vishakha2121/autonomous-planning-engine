│ │ API Routers │─▶│ Services │─▶│ Repositories │ │
│ └──────────────┘ └──────┬───────┘ └────────┬─────────┘ │
│ │ │ │
│ ┌─────────────────┼────────────────────┘ │
│ ▼ ▼ │
│ ┌────────────┐ ┌────────────────┐ ┌────────────────┐ │
│ │ HTN │ │ LangGraph │ │ Gemini LLM │ │
│ │ Planner │──▶│ Workflow │──▶│ Client │ │
│ └────────────┘ └───────┬────────┘ └────────────────┘ │
│ │ │
│ ┌─────────────────┼─────────────────┐ │
│ ▼ ▼ ▼ │
│ ┌────────────┐ ┌────────────────┐ ┌──────────────┐ │
│ │ MCP Tools │ │ Vector Memory │ │ SQLite DB │ │
